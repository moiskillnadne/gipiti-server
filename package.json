  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node dist/index.js",
    "start:prod": "npm run migrate:deploy && npm run start",
    "build": "tsc",
    "dev": "dotenvx run -f .env -- tsx watch src/index.ts",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html,json}\"",
    "lint": "eslint .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.899.0",
    "@aws-sdk/credential-provider-node": "^3.901.0",
    "@dotenvx/dotenvx": "^1.51.0",
    "@prisma/client": "^6.16.3",
    "@serdnam/pino-cloudwatch-transport": "^1.0.4",
    "aws-jwt-verify": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "prisma": "^6.16.3",
    "winston": "^3.18.3",
    "winston-cloudwatch": "^6.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1"
  }
}
